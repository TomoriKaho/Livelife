[Unit]
Description=Livelife backend and SSH tunnel recovery
After=network-online.target livelife-gateway.service

[Service]
Type=oneshot
User=livelife
Group=livelife
ExecStart=/bin/sh -c 'printf "{\"op\":\"recover\"}" | /opt/livelife/control-venv/bin/python /opt/livelife/control/public-entry.py'
TimeoutStartSec=900
