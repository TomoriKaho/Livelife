{
  "name": "livelife-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:preview": "vue-tsc -b && vite build --mode preview",
    "build:production": "vue-tsc -b && vite build --mode production && node scripts/check-internal-tools-build.mjs false",
    "check:internal-tools": "node scripts/check-internal-tools-build.mjs",
    "preview": "vite preview",
    "preview:phone": "vite preview --host 0.0.0.0",
    "map:prepare": "node scripts/prepare-campus-map.mjs",
    "map:download": "node scripts/download-campus-map.mjs",
    "test:map": "node --test scripts/campus-map.test.mjs",
    "test:drawer": "node --test scripts/activity-drawer.test.mjs",
    "test:composer": "node --test scripts/composer-layout.test.mjs",
    "test:favorites": "node --test scripts/favorites.test.mjs",
    "test:plan": "node --test scripts/campus-plan.test.mjs",
    "android:sync": "npm run build:preview && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:unsigned": "cd android && ./gradlew --no-daemon --max-workers=2 assembleRelease"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@better-scroll/core": "^2.5.1",
    "@better-scroll/mouse-wheel": "^2.5.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~5.7.0",
    "vite": "^8.3.2",
    "vue-tsc": "^2.2.0"
  }
}
