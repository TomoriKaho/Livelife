# Livelife 前端环境变量（演示用）
# 复制为 .env 后按需修改，.env 不纳入版本控制。

# 后端 API 基地址
# 网页开发时可用 http://localhost:8000
# Android 联调时改为手机可访问的后端地址（如 http://192.168.x.x:8000）
VITE_API_BASE_URL=http://localhost:8000

# 网页预览由 CI 设置为 true，启动时必须读取同目录 runtime-config.json。
# 本地开发和原生打包保持 false；此配置不包含任何访问凭证。
VITE_WEB_PREVIEW=false
