# Copy to backend/.env and fill in your mail provider's SMTP settings.
# Process environment variables take priority; restart the backend after edits.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional server-only model settings. Never put these in frontend configuration.
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_REASONING_EFFORT=

# Hybrid retrieval is opt-in. API and index worker must share the same profile.
RETRIEVAL_MODE=keyword
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=10
RETRIEVAL_MIN_SIMILARITY=0.55
RETRIEVAL_CHUNK_CHARS=600
RETRIEVAL_OVERLAP_CHARS=80
