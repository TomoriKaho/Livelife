# Copy to backend/.env and fill in your mail provider's SMTP settings.
# Process environment variables take priority; restart the backend after edits.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional server-only model settings. Never put these in frontend configuration.
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_REASONING_EFFORT=
